#!/usr/bin/env bash
# Hikari Server CLI — start/stop/inspect the local backend daemon.
# Default action (no args) = start in background.

set -e

# ─── Config ─────────────────────────────────────────────────────────────────
BACKEND_DIR="/Users/ayysir/Desktop/Hikari/backend"
# Absoluter Pfad zu diesem Skript — der Supervisor wird per "$SELF __supervise"
# gestartet, nachdem run_build schon ins Backend-Verzeichnis gewechselt hat; ein
# relativer Aufruf (./cli/hikari) fände sich dort nicht mehr.
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
NODE_PATH_PREFIX="/opt/homebrew/opt/node@24/bin"

PORT="${PORT:-3939}"
SERVICE_NAME="hikari"
# Magic-DNS hostname is stable across IP changes. Override via $HIKARI_HOST if needed.
MAGIC_DNS_HOST="${HIKARI_HOST:-macbook-pro.taile64a95.ts.net}"

STATE_DIR="$HOME/.hikari"
PID_FILE="$STATE_DIR/server.pid"
LOG_FILE="$STATE_DIR/server.log"
BUILD_STAMP="$BACKEND_DIR/dist/.build-stamp"
# V8-Heap-Limit: Default (~4GB) hat nachts zu FatalProcessOutOfMemory geführt.
NODE_HEAP_MB="${HIKARI_HEAP_MB:-8192}"

mkdir -p "$STATE_DIR"

# ─── Helpers ────────────────────────────────────────────────────────────────
RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; AMBER=$'\033[38;5;214m'
DIM=$'\033[2m'; BOLD=$'\033[1m'; RESET=$'\033[0m'

read_pid() {
    [[ -f "$PID_FILE" ]] && cat "$PID_FILE" || echo ""
}

# Process alive AND health endpoint identifies as Hikari.
is_running() {
    local pid
    pid=$(read_pid)
    [[ -n "$pid" ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    health_says_hikari
}

# Returns 0 only if /health body contains "service":"hikari".
# Prevents foreign servers (Remotion, Vite, ...) from masquerading as Hikari.
health_says_hikari() {
    local body
    body=$(curl -s --max-time 1 "http://localhost:$PORT/health" 2>/dev/null) || return 1
    [[ -n "$body" ]] || return 1
    echo "$body" | grep -q "\"service\":[[:space:]]*\"$SERVICE_NAME\""
}

kill_tree() {
    local pid="$1"
    local sig="${2:-TERM}"
    pkill -"$sig" -P "$pid" 2>/dev/null || true
    kill -"$sig" "$pid" 2>/dev/null || true
}

# Returns the PID that holds $PORT, or empty if none.
port_holder_pid() {
    lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -n1
}

# Altes Log als .prev behalten statt es zu löschen — sonst ist nach einem
# Restart die Crash-Ursache der letzten Nacht unwiederbringlich weg.
rotate_log() {
    local file="$1"
    [[ -f "$file" ]] && mv "$file" "$file.prev"
    : > "$file"
}

# iCloud-Schutz: Desktop liegt in iCloud Drive. Bei knappem Speicher lagert
# macOS Dateien aus ("dataless") — node hängt dann beim Laden still, ohne
# Fehler und ohne Log-Zeile. Vor jedem Start ausgelagerte Dateien zurückholen
# (Lesen löst den Download aus). node_modules liegt als Symlink auf
# node_modules.nosync, das iCloud nicht synchronisiert/auslagert.
ensure_local_files() {
    local count
    count=$(find "$BACKEND_DIR" -flags +dataless -type f 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$count" -gt 0 ]]; then
        echo "${YELLOW}iCloud hat $count Backend-Dateien ausgelagert — hole sie zurück...${RESET}"
        find "$BACKEND_DIR" -flags +dataless -type f -print0 2>/dev/null \
            | xargs -0 -P 16 -n 50 cat > /dev/null 2>&1 || true
        count=$(find "$BACKEND_DIR" -flags +dataless -type f 2>/dev/null | wc -l | tr -d ' ')
        if [[ "$count" -gt 0 ]]; then
            echo "${RED}Noch $count Dateien nicht lokal — Start abgebrochen (node würde hängen).${RESET}"
            find "$BACKEND_DIR" -flags +dataless -type f 2>/dev/null | head -5 | sed "s/^/  ${DIM}/;s/$/${RESET}/"
            return 1
        fi
        echo "${GREEN}Alle Dateien wieder lokal.${RESET}"
    fi
    if [[ -d "$BACKEND_DIR/node_modules" && ! -L "$BACKEND_DIR/node_modules" ]]; then
        echo "${YELLOW}Hinweis: backend/node_modules ist wieder ein echter Ordner (npm install?) — iCloud kann ihn auslagern.${RESET}"
        echo "${DIM}  Fix: cd backend && rm -rf node_modules.nosync && mv node_modules node_modules.nosync && ln -s node_modules.nosync node_modules${RESET}"
    fi
}

# Build nötig? Nur wenn src/package.json/tsconfig neuer sind als der Stamp
# des letzten erfolgreichen Builds. Spart die ~40s tsc bei jedem Restart.
needs_build() {
    [[ -f "$BUILD_STAMP" ]] || return 0
    local changed
    changed=$(find "$BACKEND_DIR/src" "$BACKEND_DIR/package.json" "$BACKEND_DIR/tsconfig.json" \
        -newer "$BUILD_STAMP" -print -quit 2>/dev/null)
    [[ -n "$changed" ]]
}

run_build() {
    echo "${AMBER}Baue Backend (tsc) — dauert ca. 30-60s...${RESET}"
    cd "$BACKEND_DIR"
    # Output live ins Terminal UND ins Log; Exit-Code von npm via PIPESTATUS.
    PATH="$NODE_PATH_PREFIX:$PATH" npm run build 2>&1 | tee -a "$LOG_FILE" | sed "s/^/  ${DIM}/;s/$/${RESET}/"
    local rc=${PIPESTATUS[0]}
    if [[ $rc -ne 0 ]]; then
        echo "${RED}Build fehlgeschlagen (Exit $rc).${RESET}"
        echo "${DIM}  Volle Logs: ${BOLD}hikari logs${RESET}"
        return 1
    fi
    touch "$BUILD_STAMP"
    echo "${GREEN}Build ok.${RESET}"
}

# Waits up to 10s for the server to come up AND identify itself as Hikari.
wait_for_health() {
    local i=0
    while (( i < 40 )); do
        if health_says_hikari; then
            return 0
        fi
        sleep 0.25
        ((i++))
    done
    return 1
}

# ─── Backend start/stop ──────────────────────────────────────────────────────
start_backend() {
    if is_running; then
        echo "${YELLOW}Backend läuft schon${RESET} (PID $(read_pid))"
        return 0
    fi

    # Stale PID-File aufräumen.
    if [[ -f "$PID_FILE" ]]; then
        local stale_pid
        stale_pid=$(read_pid)
        if [[ -n "$stale_pid" ]] && kill -0 "$stale_pid" 2>/dev/null; then
            echo "${DIM}Räume hängenden Backend-Prozess auf (PID $stale_pid)...${RESET}"
            kill_tree "$stale_pid" TERM
            sleep 0.5
            kill -0 "$stale_pid" 2>/dev/null && kill_tree "$stale_pid" KILL
        fi
        rm -f "$PID_FILE"
    fi

    # Pre-Flight: hält jemand den Port?
    local holder
    holder=$(port_holder_pid)
    if [[ -n "$holder" ]]; then
        if health_says_hikari; then
            # Verwaister Hikari-Server (PID-File fehlt/stale) — übernehmen wir.
            echo "${DIM}Räume verwaisten Hikari-Server auf (PID $holder)...${RESET}"
            kill_tree "$holder" TERM
            sleep 0.5
            kill -0 "$holder" 2>/dev/null && kill_tree "$holder" KILL
        else
            local cmd
            cmd=$(ps -p "$holder" -o command= 2>/dev/null | cut -c1-90)
            echo "${RED}Port $PORT ist belegt — von einem fremden Prozess:${RESET}"
            echo "${DIM}  PID $holder: $cmd${RESET}"
            echo ""
            echo "${DIM}Optionen:${RESET}"
            echo "${DIM}  • ${BOLD}kill $holder${RESET}${DIM} — wenn du den Prozess nicht mehr brauchst${RESET}"
            echo "${DIM}  • ${BOLD}PORT=3940 hikari${RESET}${DIM} — Hikari auf einem anderen Port starten${RESET}"
            return 1
        fi
    fi

    rotate_log "$LOG_FILE"
    ensure_local_files || return 1
    # Build with node@24's tsc (npm scripts), then run dist/ with system node so
    # the native module (better-sqlite3) ABI matches.
    if needs_build; then
        run_build || return 1
    else
        echo "${DIM}Code unverändert — Build übersprungen. (Erzwingen: ${BOLD}hikari build${RESET}${DIM})${RESET}"
    fi

    echo "${AMBER}Starte Backend im Hintergrund auf Port $PORT...${RESET}"
    cd "$BACKEND_DIR"
    # Supervisor-Modus: startet node und startet es bei Crash automatisch neu.
    PORT="$PORT" nohup "$SELF" __supervise >> "$LOG_FILE" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"

    if ! kill -0 "$pid" 2>/dev/null; then
        echo "${RED}Backend-Prozess ist sofort gestorben.${RESET}"
        rm -f "$PID_FILE"
        tail -n 12 "$LOG_FILE" | sed "s/^/  /"
        return 1
    fi

    if wait_for_health; then
        echo "${GREEN}Backend läuft${RESET} (PID $pid, Port $PORT)"
    else
        echo "${RED}Backend reagiert nicht binnen 10s.${RESET}"
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PID_FILE"
        fi
        tail -n 12 "$LOG_FILE" | sed "s/^/  /"
        return 1
    fi
}

stop_backend() {
    local pid
    pid=$(read_pid)

    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
        if [[ -f "$PID_FILE" ]]; then
            rm -f "$PID_FILE"
            echo "${DIM}Backend stale PID aufgeräumt.${RESET}"
        else
            echo "${DIM}Backend lief nicht.${RESET}"
        fi
        return 0
    fi

    echo "${AMBER}Stoppe Backend (PID $pid)...${RESET}"
    kill_tree "$pid" TERM

    local i=0
    while (( i < 20 )) && kill -0 "$pid" 2>/dev/null; do
        sleep 0.25
        ((i++))
    done

    if kill -0 "$pid" 2>/dev/null; then
        echo "${YELLOW}TERM ignoriert — nehme den Hammer.${RESET}"
        kill_tree "$pid" KILL
    fi

    rm -f "$PID_FILE"
    echo "${GREEN}Backend gestoppt.${RESET}"
}

# ─── Supervisor (interner Modus, via `hikari __supervise`) ──────────────────
# Läuft als nohup-Hintergrundprozess; PID_FILE zeigt auf DIESEN Prozess.
# Startet das Backend und bei Crash (z.B. nächtliches OOM) automatisch neu.
cmd_supervise() {
    set +e
    cd "$BACKEND_DIR"
    local child=0
    trap 'kill "$child" 2>/dev/null; exit 0' TERM INT
    local fast_deaths=0
    while true; do
        local started now code
        started=$(date +%s)
        echo "[supervisor] $(date '+%F %T') starte node dist/index.js (Heap: ${NODE_HEAP_MB}MB)"
        PORT="$PORT" node --max-old-space-size="$NODE_HEAP_MB" dist/index.js &
        child=$!
        wait "$child"
        code=$?
        [[ $code -eq 0 ]] && { echo "[supervisor] sauberer Exit."; break; }
        # PID-File weg oder zeigt auf jemand anderen → wir wurden abgelöst/gestoppt.
        [[ -f "$PID_FILE" && "$(cat "$PID_FILE" 2>/dev/null)" == "$$" ]] || { echo "[supervisor] abgelöst — Ende."; break; }
        now=$(date +%s)
        if (( now - started < 15 )); then
            ((fast_deaths++))
            if (( fast_deaths >= 5 )); then
                echo "[supervisor] Backend stirbt sofort ($fast_deaths mal in Folge) — gebe auf."
                rm -f "$PID_FILE"
                exit 1
            fi
        else
            fast_deaths=0
        fi
        echo "[supervisor] Backend-Exit (Code $code) um $(date '+%F %T') — Neustart in 3s..."
        sleep 3
    done
}

# ─── Commands ───────────────────────────────────────────────────────────────
cmd_start() {
    start_backend || return 1
    echo ""
    echo "${DIM}  Logs:      ${BOLD}hikari logs${RESET}"
    echo "${DIM}  Stoppen:   ${BOLD}hikari stop${RESET}"
    echo "${DIM}  URL:       http://localhost:$PORT  ·  http://$MAGIC_DNS_HOST:$PORT${RESET}"
}

cmd_stop() {
    stop_backend
}

cmd_status() {
    echo "${BOLD}Backend:${RESET}"
    if is_running; then
        local pid
        pid=$(read_pid)
        echo "  ${GREEN}● running${RESET}  (PID $pid, Port $PORT)"
        local body
        body=$(curl -s --max-time 1 "http://localhost:$PORT/health" 2>/dev/null)
        echo "  ${DIM}/health: $body${RESET}"
    else
        local holder
        holder=$(port_holder_pid)
        if [[ -n "$holder" ]]; then
            local cmd
            cmd=$(ps -p "$holder" -o command= 2>/dev/null | cut -c1-90)
            echo "  ${YELLOW}○ stopped${RESET}  ${DIM}(aber Port $PORT ist belegt)${RESET}"
            echo "  ${DIM}PID $holder: $cmd${RESET}"
        else
            echo "  ${DIM}○ stopped${RESET}"
        fi
    fi


    if [[ -d "$STATE_DIR" ]]; then
        local size
        size=$(du -sh "$STATE_DIR" 2>/dev/null | awk '{print $1}')
        echo ""
        echo "${DIM}  $STATE_DIR: $size${RESET}"
    fi
}

cmd_restart() {
    stop_backend
    sleep 0.5
    start_backend || return 1
    echo ""
    echo "${DIM}  URL: http://localhost:$PORT  ·  http://$MAGIC_DNS_HOST:$PORT${RESET}"
}

cmd_logs() {
    if [[ ! -f "$LOG_FILE" ]]; then
        echo "${DIM}Noch keine Backend-Logs.${RESET}"
        return 1
    fi
    tail -F -n 50 "$LOG_FILE"
}

cmd_fg() {
    if is_running; then
        echo "${YELLOW}Background-Server läuft schon (PID $(read_pid)).${RESET}"
        echo "${DIM}  Erst ${BOLD}hikari stop${RESET}${DIM} damit nichts kollidiert.${RESET}"
        return 1
    fi
    local holder
    holder=$(port_holder_pid)
    if [[ -n "$holder" ]]; then
        echo "${RED}Port $PORT ist belegt (PID $holder). Erst aufräumen.${RESET}"
        return 1
    fi
    echo "${AMBER}Starte Backend im Vordergrund auf Port $PORT — Ctrl+C beendet.${RESET}"
    cd "$BACKEND_DIR"
    exec env PORT="$PORT" PATH="$NODE_PATH_PREFIX:$PATH" npm run dev
}

cmd_help() {
    cat <<EOF
${BOLD}Hikari${RESET} — Backend-CLI

${BOLD}USAGE${RESET}
  ${AMBER}hikari${RESET}                    Starte Backend im Hintergrund (default)
  ${AMBER}hikari start${RESET}              Wie oben (Backend mit Auto-Restart bei Crash)
  ${AMBER}hikari stop${RESET}               Stoppe Backend
  ${AMBER}hikari restart${RESET}            Stop + Start
  ${AMBER}hikari status${RESET}             Status + Health-Check
  ${AMBER}hikari logs${RESET}               Live-Backend-Logs (tail -F)
  ${AMBER}hikari build${RESET}              Build erzwingen (sonst nur bei Code-Änderung)
  ${AMBER}hikari fg${RESET}                 Backend im Vordergrund starten (debug)
  ${AMBER}hikari -h${RESET}                 Diese Hilfe

${BOLD}ENV VARS${RESET}
  ${DIM}PORT=3940 hikari          Anderer Port (Default: 3939)${RESET}
  ${DIM}HIKARI_HOST=... hikari    Anderer Tailscale-Hostname für die URL-Anzeige${RESET}
  ${DIM}HIKARI_HEAP_MB=8192      V8-Heap-Limit für das Backend (MB)${RESET}

${BOLD}DATEIEN${RESET}
  ${DIM}~/.hikari/server.pid      PID des Supervisors (startet Backend bei Crash neu)${RESET}
  ${DIM}~/.hikari/server.log      Backend-Output (Vorgänger: server.log.prev)${RESET}

${BOLD}URLS${RESET}
  ${DIM}http://localhost:$PORT            (lokal)${RESET}
  ${DIM}http://$MAGIC_DNS_HOST:$PORT    (Tailscale, fürs Handy)${RESET}
EOF
}

# ─── Dispatch ───────────────────────────────────────────────────────────────
case "${1:-start}" in
    start|up)         cmd_start ;;
    stop|down)        cmd_stop ;;
    restart)          cmd_restart ;;
    status|st)        cmd_status ;;
    logs|log|tail)    cmd_logs ;;
    build|rebuild)    run_build ;;
    fg|foreground)    cmd_fg ;;
    __supervise)      cmd_supervise ;;
    -h|--help|help)   cmd_help ;;
    *)
        echo "${RED}Unknown command: $1${RESET}" >&2
        echo ""
        cmd_help
        exit 1
        ;;
esac
