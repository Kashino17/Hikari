<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Russisch-Kurs: Sprechübungen (Spracherkennung + eigene Aufnahme) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Russisch-Bereich: Aufnahme der eigenen Stimme in der WebView (Nachsprechen) braucht beides. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Android 11+: Spracherkennungs-Dienst sichtbar machen, sonst meldet
         SpeechRecognizer.isRecognitionAvailable() immer false. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Health Connect: nur lesen (Fitness-Coach: Tagesform aus Schlaf und Ruhepuls) -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Sprachnachrichten: Upload im Hintergrund (WorkManager, expedited). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Für den In-App-Updater: Installation der heruntergeladenen APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- WhatsApp-Wächter: liest WhatsApps Medienordner direkt, um Dateien beim Download zu sichern. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- WhatsApp-Wächter: War WhatsApp offen, als eine Einzelnachricht verschwand? (gelesen vs. gelöscht) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".HikariApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hikari">

        <!-- Disable WorkManager's default initializer; HikariApp provides its own
             Configuration with the HiltWorkerFactory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- FileProvider für den In-App-Updater: gibt das geladene APK aus dem
             Cache an den System-Paket-Installer weiter. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.hikari.app.cast.HikariCastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.Hikari">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Teilen-Ziel: Ein Link aus Chrome & Co. landet direkt im
                 Import-Sheet; Seiten mit eingebettetem Player werden im
                 Hintergrund nach dem Stream durchsucht. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Teilen-Ziel für Sprachnachrichten (WhatsApp: Sprachnachrichten
             markieren, Teilen, Hikari). Unsichtbar: kopiert, gibt an den
             Worker weiter, schließt sofort — man bleibt in WhatsApp. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".voice.VoiceShareActivity"
            android:exported="true"
            android:label="Hikari: zusammenfassen"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>

        <!-- Aufgaben: Aufnahme-Fenster (Schnellmenü, Widget, Mikrofon im Reiter). Eigene Aufgabe,
             damit es über jeder App aufgeht, ohne Hikari nach vorne zu holen. -->
        <activity
            android:name=".tasks.TaskCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.hikari.app.tasks"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Hikari.TaskCapture" />

        <!-- Eigener Starter »Hikari Aufgabe« — z. B. für Seitentaste zweimal drücken. -->
        <activity-alias
            android:name=".tasks.TaskLauncher"
            android:exported="true"
            android:label="Hikari Aufgabe"
            android:icon="@mipmap/ic_task_launcher"
            android:roundIcon="@mipmap/ic_task_launcher"
            android:targetActivity=".tasks.TaskCaptureActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Teilen-Ziel: Text aus WhatsApp, Mail & Co. wird zur Aufgabe. -->
        <activity
            android:name=".tasks.TaskShareActivity"
            android:exported="true"
            android:label="Hikari Aufgabe"
            android:icon="@mipmap/ic_task_launcher"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".tasks.TaskTileService"
            android:exported="true"
            android:icon="@drawable/ic_task_tile"
            android:label="Aufgabe"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".tasks.TasksWidget"
            android:exported="false"
            android:label="Hikari Aufgaben">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tasks_info" />
        </receiver>

        <receiver
            android:name=".tasks.TaskActionReceiver"
            android:exported="false" />

        <!-- WorkManager-Vordergrunddienst für den Sprachnachrichten-Upload. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- System-Mediasteuerung: Sperrbildschirm, Benachrichtigungs-Widget,
             Kopfhörer-Tasten. -->
        <service
            android:name=".player.MusicPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Russisch-Podcast im Hintergrund (eigene Session neben der Musik). -->
        <service
            android:name=".player.RussianPodcastService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- WhatsApp-Ecke: Lokaler Benachrichtigungs-Wächter für gelöschte &
             bearbeitete WhatsApp-Nachrichten. -->
        <service
            android:name=".whatsapp.WhatsAppNotificationListenerService"
            android:label="Hikari WhatsApp-Wächter"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
